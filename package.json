{
  "name": "rise-of-the-realm",
  "private": true,
  "version": "1.0.0",
  "description": "Rise of the Realm",
  "author": "Rise of the Realm",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "vite build && electron-builder --win --dir",
    "desktop:build": "vite build && electron-builder --win",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "world:smoke": "node scripts/world-smoke.mjs",
    "world:review": "node scripts/world-review.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node tests/smoke.mjs && node tests/systems.mjs && node tests/settings.mjs && node tests/content.mjs && node tests/uidiscipline.mjs && node tests/structure.mjs && node tests/save.mjs && node tests/ambient.mjs && node tests/overlays.mjs && node tests/autoattack.mjs && node tests/weapons-elements.mjs && node tests/elites-boss.mjs && node tests/ashen-frontier.mjs && node tests/regions.mjs && node tests/region-pipeline.mjs && node tests/world-events.mjs && node tests/shards.mjs && node tests/story.mjs && node tests/items.mjs && node tests/storage.mjs",
    "typecheck": "tsc --noEmit",
    "graphify": "madge --extensions ts,tsx --layout dot --image docs/dependency-graph.svg --rankdir LR src/",
    "graphify:circular": "madge --extensions ts,tsx --circular --layout dot --image docs/circular-deps.svg --rankdir LR src/",
    "graphify:json": "madge --extensions ts,tsx --json src/ > docs/dependency-graph.json",
    "graphify:summary": "madge --extensions ts,tsx --summary src/",
    "graphify:orphans": "madge --extensions ts,tsx --orphans src/",
    "graphify:dot": "madge --extensions ts,tsx --dot src/"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.riseoftherealm.game",
    "productName": "Rise of the Realm",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "graphviz": "^0.0.9",
    "madge": "^8.0.0",
    "playwright": "^1.63.0",
    "ts-graphviz": "^3.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
